# Copy this file to .env and fill in your values. Never share or commit .env.

# ---------- PostgreSQL (one database; schemas bronze, silver, gold, audit are created by --setup)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=datatrust_poc
PG_USER=postgres
PG_PASSWORD=your-postgres-password

# ---------- Where the CSV files come from: local (data/source_csv) or adls
SOURCE_MODE=local

# ---------- ADLS Gen2 (only needed for upload_to_adls.py and SOURCE_MODE=adls)
# Option 1: account name + key (Azure portal -> Storage account -> Access keys)
ADLS_ACCOUNT_NAME=yourstorageaccount
ADLS_ACCOUNT_KEY=
# Option 2: connection string instead (also from Access keys).
#   For the free local emulator Azurite use:  ADLS_CONNECTION_STRING=UseDevelopmentStorage=true
ADLS_CONNECTION_STRING=
# Option 3: leave key and connection string empty -> uses your Azure login (az login)
ADLS_CONTAINER=landing
ADLS_FOLDER=datatrust/source_csv

# ---------- How Spark writes to PostgreSQL: python (default, no downloads) or jdbc
WRITE_MODE=python

# ---------- DataTrust AI web app (python web/server.py -> http://localhost:8000)
WEB_PORT=8000
# 'last month', 'last 7 days' ... count back from: data = latest business date in gold (default), today = calendar date
DATATRUST_AS_OF=data
# AI model for free-form questions: none (built-in agent, free, offline) | ollama (free, local) | anthropic (paid API)
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Kafka streaming add-on (streaming/)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=datatrust-bronze-loader
KAFKA_TOPIC_PREFIX=datatrust
KAFKA_MICRO_BATCH_SECONDS=30
KAFKA_MICRO_BATCH_MAX_EVENTS=5000
KAFKA_RUN_SILVER_GOLD=true
# managed Kafka (Confluent Cloud / Azure Event Hubs): SASL_SSL + user/password
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------- Data Estate module (web portal login)
# first admin, created on the first start of python web\server.py (if empty, a password is generated and printed once)
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=
# signs the login cookie; leave empty to let the portal generate and keep one
PORTAL_SECRET=
# passwords of other connected sources, referenced by name on the Connections page, e.g.
# CONN_FINANCE_PASSWORD=...
